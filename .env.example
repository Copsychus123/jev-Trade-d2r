TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Price used for the cost estimate shown in the demo (USD per million tokens). Defaults: published TypeSafe card.
# JEV_INPUT_USD_PER_MILLION=0.042
# JEV_OUTPUT_USD_PER_MILLION=0
# Demo port (default 8766); the demo prints the URL it serves.
# TYPESAFE_DEMO_PORT=8766
# Optional Traderie auth for Recent Trades without record_flights.py
# TRADERIE_COOKIE=name=value; other=two
# TRADERIE_SESSION_TOKEN=your_session_token
# TRADERIE_SESSION_COOKIE_NAME=session
# Friends-edition backend (services/)
KV_REST_API_URL=
KV_REST_API_TOKEN=
RUN_TOKEN_SECRET=
# How often a network error or HTTP 429/503/529 is retried (default 3), and the backoff it waits (seconds).
# API_RETRY_COUNT=3
# API_INITIAL_RETRY_DELAY_SECONDS=0.5
# API_MAX_RETRY_DELAY_SECONDS=16
# Which Chrome to run, when more than one is installed (the harness name BH_CHROME_PATH wins if both are set).
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
