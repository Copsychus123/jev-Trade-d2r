TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Defaults to https://api.typesafe.ai. Set to https://openrouter.ai/api to route
# jev through OpenRouter instead. Use the bare TYPESAFE_MODEL id (no typesafe/ prefix);
# OpenRouter resolves it on its own.
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
